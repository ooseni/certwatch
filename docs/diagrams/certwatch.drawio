        <mxCell id="title" value="CertWatch&lt;br&gt;&lt;span style=&quot;font-size:13px;font-weight:normal&quot;&gt;Delivery pipeline (GitHub Actions to AWS)&lt;/span&gt;" style="text;html=1;fontFamily=Arial;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=22;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="1000" height="50" as="geometry" />
        </mxCell>
        <mxCell id="notes" value="&lt;b style=&quot;font-size:16px&quot;&gt;Legend&lt;/b&gt;&lt;ol style=&quot;padding-left:20px;margin-top:10px;margin-bottom:10px&quot;&gt;&lt;li style=&quot;margin-bottom:6px&quot;&gt;Developer pushes a branch or opens a pull request.&lt;/li&gt;&lt;li style=&quot;margin-bottom:6px&quot;&gt;The workflow lints, runs unit tests, then integration tests against &lt;b&gt;LocalStack&lt;/b&gt;.&lt;/li&gt;&lt;li style=&quot;margin-bottom:6px&quot;&gt;On &lt;font color=&quot;#5A6C86&quot;&gt;main&lt;/font&gt;, the job exchanges its GitHub OIDC token for the deploy role; no stored AWS keys.&lt;/li&gt;&lt;li style=&quot;margin-bottom:6px&quot;&gt;The role runs &lt;font color=&quot;#5A6C86&quot;&gt;sam deploy&lt;/font&gt;, scoped to CertWatch stacks.&lt;/li&gt;&lt;li style=&quot;margin-bottom:6px&quot;&gt;&lt;b&gt;CloudFormation&lt;/b&gt; updates the &lt;font color=&quot;#5A6C86&quot;&gt;dev&lt;/font&gt; stack first.&lt;/li&gt;&lt;li style=&quot;margin-bottom:6px&quot;&gt;&lt;font color=&quot;#5A6C86&quot;&gt;prod&lt;/font&gt; deploys only after a manual approval on the GitHub environment.&lt;/li&gt;&lt;/ol&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=13;fontColor=#232F3E;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1590" y="140" width="230" height="470" as="geometry" />
        </mxCell>
